APP_ENV=development
API_ADDR=:8080
DATABASE_URL=postgres://purels:purels@localhost:5432/purels?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Base URL used when rendering short links, e.g. http://localhost/<alias>.
PUBLIC_URL=http://localhost
# Comma-separated browser origins allowed to call the API cross-origin.
# Not needed when the frontend calls the API same-origin.
ADMIN_ORIGIN=http://localhost:3000,http://localhost
COOKIE_SECURE=false
SESSION_TTL=24h

BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=change-me-now

# Extra bare host names a link may be filed under, besides the host in
# PUBLIC_URL. The scheme always comes from PUBLIC_URL. Each host has to resolve
# to this deployment on its own: a short code is global, so the domain only
# decides what the console shows and what the QR code encodes.
SHORT_DOMAINS=
# What goes into the ip_hash columns: none, anonymised or pseudonymised (the
# default). "none" stores nothing, which also hides the unique-visitor figure.
# The other two break COUNT(DISTINCT ip_hash) across the switch, because the
# same visitor hashes differently before and after.
IP_HASH_MODE=pseudonymised
# Turns the digest into an HMAC. Empty keeps the historical plain-SHA-256
# digest, so counts recorded before this setting existed stay comparable; the
# API logs a warning at boot when it is empty and the mode is not "none".
IP_HASH_KEY=

# Per-IP rate limits, in requests per minute.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10
RATE_LIMIT_API=120
RATE_LIMIT_REDIRECT=600

# Frontend. Leave NEXT_PUBLIC_API_BASE_URL empty to call the API same-origin;
# API_PROXY_TARGET is where the Next.js server forwards /api/* requests.
NEXT_PUBLIC_API_BASE_URL=
API_PROXY_TARGET=http://localhost:8080
