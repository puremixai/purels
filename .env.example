APP_ENV=development
API_ADDR=:8080
DATABASE_URL=postgres://purels:purels@localhost:5432/purels?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Base URL used when rendering short links, e.g. http://localhost/<alias>.
PUBLIC_URL=http://localhost
# IANA time zone used for daily statistics; use the same value for API and worker.
STATS_TZ=UTC
# Comma-separated browser origins allowed to call the API cross-origin.
# Not needed when the frontend calls the API same-origin.
ADMIN_ORIGIN=http://localhost:3000,http://localhost
COOKIE_SECURE=false
SESSION_TTL=24h

BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=change-me-now

# The mutable business/operations settings below are seeded into PostgreSQL on
# the first boot after migration 000018. After that, edit them in the admin
# console at /home/settings instead of changing the environment.

ALIAS_MODE=random
UNIQUE_URLS=true
REGISTRATION_ENABLED=true
COUNT_BOTS=false
FORWARD_QUERY=true
FALLBACK_URL=
AUTO_PRUNE_EXPIRED=false
PRUNE_GRACE=720h
MAX_LINKS_PER_USER=1000
DESTINATION_DENYLIST=
HEALTH_CHECK_ENABLED=false
HEALTH_CHECK_INTERVAL=24h

# Extra bare host names a link may be filed under, besides the host in
# PUBLIC_URL. The scheme always comes from PUBLIC_URL. Each host has to resolve
# to this deployment on its own: a short code is global, so the domain only
# decides what the console shows and what the QR code encodes.
SHORT_DOMAINS=
# What goes into the ip_hash columns: none, anonymised or pseudonymised (the
# default). "none" stores nothing, which also hides the unique-visitor figure.
# The other two break COUNT(DISTINCT ip_hash) across the switch, because the
# same visitor hashes differently before and after.
IP_HASH_MODE=pseudonymised
# Turns the digest into an HMAC. Setting it is recommended, and the value must
# then be kept: generate one with
#   openssl rand -base64 32
# Empty keeps the historical plain-SHA-256 digest, which is reversible by brute
# force over the IPv4 space, so the API logs a warning at boot when it is empty
# and the mode is not "none". Changing or clearing it later breaks
# COUNT(DISTINCT ip_hash) across the switch, because the same visitor hashes
# differently before and after.
IP_HASH_KEY=

# The built-in second factor's master switch. This value is a first-boot
# default only: it seeds the runtime setting on the first boot after the
# migration that adds the column, and is not read again. From then on the
# switch is a database value an operator changes in the console (Settings →
# Registration and sign-in), because turning the second factor on or off should
# not need a restart. Off means nobody is ever challenged, even an account that
# has already enrolled.
#
# Either way it needs SECRET_ENCRYPTION_KEY below: the secret is stored
# encrypted rather than hashed — verification needs the original value — and a
# secret the server cannot read back is worse than no secret at all.
TOTP_ENABLED=false
# How long the half-session between a correct password and a correct code stays
# usable.
TOTP_CHALLENGE_TTL=5m

# The key every stored secret is encrypted under: TOTP enrolment secrets and
# OIDC client secrets. 32 raw bytes, 64 hex characters, or base64 for 32 bytes.
# Generate one with
#   openssl rand -base64 32
# LOSING OR CHANGING IT INVALIDATES EVERY STORED SECRET: the ciphertext becomes
# undecryptable, nobody can produce a TOTP code, and the only way back in is for
# an administrator to reset each account from the user list. OIDC client secrets
# have to be pasted in again.
SECRET_ENCRYPTION_KEY=
# Deprecated name for the same key, still read when SECRET_ENCRYPTION_KEY is
# empty so an existing deployment keeps decrypting its enrolments. The two must
# hold the same value: the ciphertext records nothing about which name wrote it.
# TOTP_ENCRYPTION_KEY=

# OIDC sign-in providers. The providers themselves are configured in the console
# and stored in the database; these are the deployment-wide settings. Password
# login stays the primary path either way.
#
# The origin the IdP sends the browser back to. Defaults to the origin of
# PUBLIC_URL, which is right when the console and the API share a host. Set it
# explicitly when PUBLIC_URL is a different domain from the console: the value
# is registered verbatim at the IdP, so it has to be the real one.
OIDC_REDIRECT_BASE=
# How long an authorization request stays usable — the window between leaving
# for the IdP and the callback arriving.
OIDC_REQUEST_TTL=10m
# Permits an http:// issuer, for a self-hosted IdP on a private network.
# It widens what the oidc:manage scope can reach, so leave it off unless the
# issuer is one you control.
OIDC_ALLOW_INSECURE_ISSUERS=false

# Per-IP rate limits, in requests per minute.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10
RATE_LIMIT_API=120
RATE_LIMIT_REDIRECT=600
RATE_LIMIT_REGISTER=5
# Guards the second-factor endpoint. Defence in depth only: the real
# brute-force bound is the attempt counter stored with the challenge, because
# the limiter is fail-open when Redis is unavailable.
RATE_LIMIT_2FA=10
# Guards the sign-in provider list and the OIDC start/callback endpoints.
RATE_LIMIT_OIDC=60

# Frontend. Leave NEXT_PUBLIC_API_BASE_URL empty to call the API same-origin;
# API_PROXY_TARGET is where the Next.js server forwards /api/* requests.
NEXT_PUBLIC_API_BASE_URL=
API_PROXY_TARGET=http://localhost:8080
