{
	auto_https off
}

:80 {
	# Dedicated short-link host (optional): everything goes to the API.
	@short host s.example.com
	handle @short {
		reverse_proxy api:8080
	}

	# Backend API + operational endpoints.
	@api path /api/* /healthz /readyz /metrics
	handle @api {
		reverse_proxy api:8080
	}

	# Admin UI, its build assets, and the files a crawler asks for.
	# Every root-level path the console serves has to be named here: anything
	# that is not is treated as a short code and answered by the API instead.
	@web path / /_next/* /admin /admin/* /home /home/* /login /login/* /register /register/* /favicon.ico /robots.txt /sitemap.xml /icon.svg
	handle @web {
		reverse_proxy web:3000
	}

	# Anything else is a short-link alias.
	handle {
		reverse_proxy api:8080
	}
}
